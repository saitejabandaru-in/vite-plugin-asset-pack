{
  "name": "vite-plugin-asset-pack",
  "version": "1.0.0",
  "description": "Ultra-fast, zero-dependency Vite plugin for build-time SVG minification, image metadata generation, and asset optimization.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "asset-pack": "dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts",
    "build:action": "ncc build src/action.ts -o dist/action",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "track": "tsx scripts/track-metrics.ts",
    "dev:example": "npm run build && cd examples/vanilla && npm install && npm run dev",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "vite-plugin-svg",
    "asset-optimization",
    "svg",
    "svg-minifier",
    "minify",
    "image-optimizer",
    "data-uri",
    "base64",
    "inline",
    "bundle-size",
    "zero-dependency",
    "build-tool",
    "performance"
  ],
  "author": "Open Source Maintainer",
  "license": "MIT",
  "workspaces": [
    "examples/*"
  ],
  "peerDependencies": {
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/svgo": "^2.6.4",
    "@vercel/ncc": "^0.45.0",
    "semantic-release": "^25.0.8",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vitest": "^1.2.1",
    "vue": "^3.5.40"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saitejabandaru-in/vite-plugin-asset-pack.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "picocolors": "^1.1.1",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2"
  }
}
